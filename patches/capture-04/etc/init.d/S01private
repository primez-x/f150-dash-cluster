#! /bin/sh

NAME=mount
PARTITION=/dev/mmcblk0p5

restore_private(){
    [ "$moved_private" -eq 1 ] || return 0
    if [ -d /private ]; then
        rmdir /private || return $?
    fi
    mv /private-move /private
}

start(){
    printf "Mounting private"
    if [ -e /private/zj_save ] && [ -e /private-move ]; then
        echo "Conflicting private migration directories; preserve both for recovery" >&2
        return 1
    fi
    e2fsck -y "$PARTITION"
    fsck_status=$?
    case "$fsck_status" in
        0|1) ;;
        *)
            echo "e2fsck failed for $PARTITION with status $fsck_status" >&2
            return "$fsck_status"
            ;;
    esac
    moved_private=0
    if [ -e /private/zj_save ]; then
        echo "move /private"
        mv /private /private-move || return $?
        moved_private=1
    fi
    mkdir -p /private
    create_status=$?
    if [ "$create_status" -ne 0 ]; then
        restore_private || echo "Private migration rollback failed; preserve /private-move" >&2
        return "$create_status"
    fi
    mount -o sync "$PARTITION" /private
    mount_status=$?
    if [ "$mount_status" -ne 0 ]; then
        echo "Failed to mount $PARTITION on /private (status $mount_status)" >&2
        restore_private || echo "Private migration rollback failed; preserve /private-move" >&2
        return "$mount_status"
    fi
    if [ -e /private-move ]; then
        echo "migrate /private-move"
        cp -a /private-move/. /private || return $?
        rm -rf /private-move || return $?
    fi
    rm -rf /root || return $?
    mkdir -p /private/root || return $?
    ln -s /private/root /root
}

stop(){
    printf "umounting private"
}

case "$1" in
  start)
    printf "Starting $NAME: "
    start
    ;;
  stop)
    printf "Stopping $NAME: "
    stop
    ;;
  restart|reload)
    echo "Restarting $NAME: "
    stop
    start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload}" >&2
    exit 1
    ;;
esac

exit $?
