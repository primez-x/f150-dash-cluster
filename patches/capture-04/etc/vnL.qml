        if(!g.notifyTop || (tow && g.notifyText===1246))
            return ""
        var t=typeof mTranslationId!=="undefined" && mTranslationId.item?mTranslationId.item.mNotifyTextItem:""
        return typeof t==="string"?t.trim():""
    }
    readonly property string notifyKey: notifyLine!==""?notifyLine+"#"+g.notifyText+"#"+g.notifyDuration:""
    property double derivedAt: 0
    property double notifyAt: 0
    onDerivedKeyChanged: derivedAt=Date.now()
    onNotifyKeyChanged: notifyAt=Date.now()
    // A derived warn wins over an adapter caution; otherwise the newest source shows.
    readonly property var alertNow: {
        var d=derivedAlert, n=notifyLine!==""?["caution", "", notifyLine, "", false]:null
        if(d && n)
            return d[0]==="warn" || derivedAt>=notifyAt?d:n
        return d || n
    }
    // The banner keeps the last alert while the banner fades out.
    property var alertShown: ["caution", "", "", "", false]
    onAlertNowChanged: {
        if(alertNow) {
            var fresh=!alertBox.visible || alertShown[2]!==alertNow[2] || alertShown[0]!==alertNow[0]
            alertShown=alertNow
            if(fresh) {
                mAlertOutId.stop()
                mAlertInId.restart()
                if(alertNow[0]==="warn")
                    mPulseId.restart()
            }
        } else if(alertBox.visible) {
            mAlertInId.stop()
            mAlertOutId.restart()
        }
    }
    Component.onCompleted: {
        if(alertNow) {
            alertShown=alertNow
            alertBox.opacity=1
            alertBox.visible=true
        }
        hdgTarget=Number(g.gpsBearing) || 0
        hdgReady=true
        cardA.page=shownPage
        cardShown=shownPage
        mPostActionId.restart()
    }

    // Overspeed: the stock OverSpeedWarning (unit 173) asks the adapter for the setting 50 ms after the page loads.
    Timer {
        id: mPostActionId
        interval: 50
        onTriggered: {
            if(typeof mEventHandleId!=="undefined" && mEventHandleId.item && typeof mEventHandleId.item.overspeedInquire==="function")
                mEventHandleId.item.overspeedInquire()
        }
    }

    // ===== Shared parts =====
    // Symbol: Loader host properties sym (syms key), tint, and flip; the host size is the symbol box (contain fit).
    Component {
        id: mSymComp
        Item {
            id: symItem
            readonly property var host: parent
            readonly property string name: host && typeof host.sym==="string"?host.sym:""
            readonly property var d: mLayoutId.syms[name] || null
            readonly property color tint: host && host.tint!==undefined?host.tint:mLayoutId.cQuiet
            readonly property bool flip: host?host.flip===true:false
            readonly property real k: d?Math.min(width/d.w, height/d.h):1
            width: host?host.width:0
            height: host?host.height:0
            Shape {
                x: (symItem.width-width)/2
                y: (symItem.height-height)/2
                width: symItem.d?symItem.d.w:54
                height: symItem.d?symItem.d.h:54
                scale: symItem.k
                transform: [
                    Rotation { origin.x: symItem.d && symItem.d.ox?symItem.d.ox:0; origin.y: symItem.d && symItem.d.oy?symItem.d.oy:0
                               angle: symItem.d && symItem.d.rot?symItem.d.rot:0 },
                    Scale { origin.x: symItem.d?symItem.d.w/2:27; xScale: symItem.flip?-1:1 }
                ]
                ShapePath {
                    strokeColor: symItem.d && symItem.d.s!==""?symItem.tint:"transparent"
                    strokeWidth: 4.2
                    fillColor: "transparent"
                    capStyle: ShapePath.RoundCap
                    joinStyle: ShapePath.RoundJoin
                    PathSvg { path: symItem.d?symItem.d.s:"" }
                }
                ShapePath {
                    strokeColor: "transparent"
                    strokeWidth: -1
                    fillColor: symItem.d && symItem.d.f!==""?Qt.rgba(symItem.tint.r, symItem.tint.g, symItem.tint.b, symItem.d.fo):"transparent"
                    fillRule: ShapePath.OddEvenFill
                    PathSvg { path: symItem.d?symItem.d.f:"" }
                }
            }
        }
    }

    // Card body: one card page. Two persistent bodies take turns for the page slide.
    Component {
        id: mBodyComp
        Item {
            id: body
            property string page: ""
            readonly property var host: parent
            readonly property bool wide: !mLayoutId.tow
            readonly property var cells: mLayoutId.cellsFor(page)
            readonly property real sumW: {
                var s=0
                for(var i=0; i<cellRep.count; i++) {
                    var cellItem=cellRep.itemAt(i)
                    if(cellItem)
                        s+=cellItem.width
                }
                return s
            }
            readonly property int n: cells.length
            readonly property real freeW: Math.max(0, width-sumW)
            readonly property bool around: page==="level"
            readonly property real gap: n<2?0:around?freeW/n:freeW/(n-1)
            readonly property real trailerH: page==="trailer"?44:0
            width: host?host.width:0
            height: host?host.height:0

            Grid {
                id: cellGrid
                columns: body.wide?Math.max(1, body.n):1
                columnSpacing: body.wide?body.gap:0
                rowSpacing: body.page==="engine"?22:30
                x: body.wide?(body.n<2?body.freeW/2:body.around?body.gap/2:0):(body.width-width)/2
                y: (body.height-height-body.trailerH)/2
                visible: body.page!=="tires"
                Repeater {
                    id: cellRep
                    model: body.n
                    Item {
                        id: cell
                        readonly property var c: body.cells[index] || ({ s: "", v: "--", u: "" })
                        readonly property bool on: cell.c.on===true
                        readonly property int fs: body.wide?42:48
                        width: 48+valueText.width+(unitText.text!==""?4+unitText.width:0)
                        height: fs
                        Loader {
                            property string sym: cell.c.s
                            property color tint: cell.on?mLayoutId.cAcc:mLayoutId.cQuiet
                            property bool flip: cell.c.flip===true
                            y: (cell.fs-36)/2
                            width: 36
                            height: 36
                            sourceComponent: mSymComp
                        }
                        // Trip A hold ring (parent tripHold) around the Trip A symbol.
                        Shape {
                            objectName: "trip.ring"
                            x: -6
                            y: (cell.fs-48)/2
                            width: 48
                            height: 48
                            visible: cell.c.k==="trip" && mLayoutId.tripHold>0
                            ShapePath {
                                strokeColor: Qt.rgba(1, 1, 1, 0.12)
                                strokeWidth: 3
                                fillColor: "transparent"
                                PathAngleArc { centerX: 24; centerY: 24; radiusX: 22.5; radiusY: 22.5; startAngle: 0; sweepAngle: 360 }
                            }
                            ShapePath {
                                strokeColor: mLayoutId.cAcc
                                strokeWidth: 3
                                fillColor: "transparent"
                                capStyle: ShapePath.RoundCap
                                PathAngleArc { centerX: 24; centerY: 24; radiusX: 22.5; radiusY: 22.5; startAngle: -90
                                               sweepAngle: 360*mLayoutId.clamp01(mLayoutId.tripHold) }
                            }
                        }
                        Text {
                            id: valueText
                            objectName: "cell.value"
                            x: 48
                            height: cell.fs
                            verticalAlignment: Text.AlignVCenter
                            text: cell.c.v
                            color: cell.on?mLayoutId.cAcc:mLayoutId.cText
                            font.family: mLayoutId.fBmw
                            font.pixelSize: cell.fs
                            Connections {
                                target: mLayoutId
                                onTripFlash: if(cell.c.k==="trip") flashAnim.restart()
                            }
                            // flashTrip: the value blinks twice in the accent colour after a Trip A reset.
                            SequentialAnimation {
                                id: flashAnim
                                loops: 2
                                ColorAnimation { target: valueText; property: "color"; to: mLayoutId.cAcc; duration: mLayoutId.mFast }
                                NumberAnimation { target: valueText; property: "opacity"; to: 0.25; duration: mLayoutId.mBase; easing.type: Easing.InCubic }
                                NumberAnimation { target: valueText; property: "opacity"; to: 1; duration: mLayoutId.mBase; easing.type: Easing.OutCubic }
                                onStopped: valueText.color=Qt.binding(function() { return cell.on?mLayoutId.cAcc:mLayoutId.cText })
                            }
                        }
                        Text {
                            id: unitText
                            objectName: "cell.unit"
                            x: valueText.x+valueText.width+4
                            anchors.baseline: valueText.baseline
                            height: 24
                            verticalAlignment: Text.AlignVCenter
                            text: cell.c.u || ""
                            visible: text!==""
                            color: mLayoutId.cDim
                            font.family: mLayoutId.fBmw
                            font.pixelSize: 20
                        }
                    }
                }
            }
            // Trailer brake meter: the output fill scales from the left edge; the white mark shows the gain.
            Item {
                visible: body.page==="trailer"
                y: cellGrid.y+cellGrid.height+30
                width: body.width
                height: 14
                Rectangle {
                    anchors.fill: parent
                    radius: 7
                    color: Qt.rgba(1, 1, 1, 0.06)
                }
                Rectangle {
                    width: parent.width
                    height: 14
                    radius: 7
                    transform: Scale { xScale: mLayoutId.output/10 }
                    visible: mLayoutId.braking
                    gradient: Gradient {
                        orientation: Gradient.Horizontal
                        GradientStop { position: 0; color: "transparent" }
                        GradientStop { position: 1; color: mLayoutId.cAcc }
                    }
                }
                Rectangle {
                    x: parent.width*mLayoutId.gain/10-1.5
                    y: -8
                    width: 3
                    height: 30
                    color: "#ffffff"
                    opacity: 0.6
                    Behavior on x { SmoothedAnimation { duration: mLayoutId.mSmooth; velocity: -1 } }
                }
            }
            // Tires: the stock top-view truck with the four pressures.
            Item {
                id: tireBox
                visible: body.page==="tires"
                width: body.width
                height: 132
                y: (body.height-132)/2
                readonly property real dx: body.wide?135.5:110.5
                readonly property var rows: body.wide?[16, 82]:[8.5, 89.5]
                Image {
                    x: (parent.width-width)/2
                    width: 81.9
                    height: 132
                    fillMode: Image.PreserveAspectFit
                    source: mLayoutId.g.mRccPrefix+"images/vehicles/ford/door/black.png"
                }
                Repeater {
                    model: 4
                    Text {
                        objectName: "tire"
                        x: tireBox.width/2+(index%2?tireBox.dx:-tireBox.dx)-width/2
                        y: tireBox.rows[Math.floor(index/2)]
                        height: 34
                        verticalAlignment: Text.AlignVCenter
                        text: mLayoutId.tires[index] || "--"
                        color: index===mLayoutId.tireLow?mLayoutId.cCaution:"#aab2bb"
                        font.family: mLayoutId.fBmw
                        font.pixelSize: 34
                    }
                }
            }
        }
    }

