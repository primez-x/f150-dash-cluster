    // ===== View: top bar =====
    // Compass tape (round 20): 2.5 px per degree, marks every 15 degrees, labels every 45 degrees. The strip moves the
    // shorter way between fixes and holds (dimmed) at 5 mph and under or without a GPS fix.
    property real hdgTarget: 0
    property real hdgShown: hdgTarget
    property bool hdgReady: false
    Behavior on hdgShown { enabled: mLayoutId.hdgReady; SmoothedAnimation { duration: 800; velocity: -1 } }
    function hdgUpdate() {
        if(hdgHeld)
            return
        var b=Number(g.gpsBearing)
        if(isNaN(b))
            return
        var cur=((hdgTarget%360)+360)%360
        hdgTarget+=((b-cur)%360+540)%360-180
    }
    Connections {
        target: mLayoutId.g
        onGpsBearingChanged: mLayoutId.hdgUpdate()
