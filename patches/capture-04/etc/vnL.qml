    readonly property var ttLayout: {
        var right=tow?1770:1520, top=tow?114:140, maxW=300, gap=16, rowsMax=3
        var rows=[[]], rw=[0], more=0
        for(var i=0; i<ttList.length; i++) {
            var w=ttWidth[ttList[i][0]] || 46, r=rows.length-1
            if(rows[r].length && rw[r]+gap+w>maxW) {
                if(rows.length===rowsMax) {
                    more=ttList.length-i
                    break
                }
                rows.push([])
                rw.push(0)
                r++
            }
            rw[r]+=(rows[r].length?gap:0)+w
            rows[r].push([ttList[i][0], ttList[i][1], w])
        }
        if(more>0) {
            var last=rows.length-1
            while(rows[last].length && rw[last]+gap+40>maxW) {
                var drop=rows[last].pop()
                rw[last]-=drop[2]+(rows[last].length?gap:0)
                more++
            }
            rw[last]+=(rows[last].length?gap:0)+40
        }
        var out=[]
        for(var j=0; j<rows.length; j++) {
            var x=right-rw[j]
            for(var k=0; k<rows[j].length; k++) {
                out.push({ id: rows[j][k][0], st: rows[j][k][1], w: rows[j][k][2], x: x, y: top+j*56 })
                x+=rows[j][k][2]+gap
            }
        }
        return { items: out, more: more, mx: right-40, my: top+(rows.length-1)*56 }
    }
