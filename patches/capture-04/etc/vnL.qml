import QtQuick 2.12
import QtQuick.Shapes 1.12

// Daily A (option A, crescents) and Towing A: the two locked dashboard layouts in one file. Design: design/round-42
// (kit42.js, the layout geometry in design/round-42/geometry/<layout>-<scene>.json) on the round 41 motion system.
// tests/qt-layout-preview.py renders every geometry scene on the host and compares this file with the design.
// Parent contract (vnD):
// - Root item 1920 x 932 at 0,0 with no margins. tow follows Global dashboard (1 = Towing A, else Daily A).
// - pages: the card pages. The card shows pages[drivingInfoIndex], or pages[0] for an index outside the pages (as vnD
//   pages and tests the Trip A card); a change slides (round 41 A).
// - tripHold (0 to 1) draws the hold ring on the Trip A cell; flashTrip() flashes the Trip A value after a reset.
// - ownsNotify: this layout draws the adapter notification banner and the trailer brake gain (notify 1246), so the
//   parent stops drawing the stock Notify and Dragging popups for this layout.
// - The layout draws the turn edges, the cruise region, the warning lights, and the overspeed badge. The stock
//   AlarmPage units 161 (UI1), 140 (UI2), and 123 (UI3 to UI6) drew the lights and the badge before.
// Data: Global names, units, and sentinels. Every invalid reading shows "--" from the first evaluation.
// "Inferred" marks a field mapping without a firmware or truck log reference.
// Rules: no QtGraphicalEffects, no Canvas, no script loops per frame. Guard every index, getter, and undefined value:
// a log line with the /etc/vn path rolls the install back.
// Motion (design/round-41 tokens): fast 120 ms, base 200 ms, slow 280 ms, smooth 240 ms, Easing.OutCubic in,
// Easing.InCubic out.
Item {
    id: mLayoutId
    x: 0
    y: 0
    width: 1920
    height: 932

    // ===== Contract =====
    readonly property QtObject g: mGlobalId.item
    readonly property bool tow: g.dashboard===1
    readonly property var pages: tow?["trailer", "tires", "engine", "level", "trip"]:["trip", "economy", "tires", "engine", "level"]
    property real tripHold: 0
    readonly property bool ownsNotify: true
    signal tripFlash()
    function flashTrip() {
        tripFlash()
    }

    // ===== Tokens =====
    readonly property string fBmw: "BMW Type Global"
    readonly property string fKonexy: "Konexy Personal Use"
    readonly property color cAcc: "#5ad1c0"         // accent teal (rgb 90, 209, 192)
    readonly property color cOk: "#3ee07a"
    readonly property color cCaution: "#ffb020"
    readonly property color cWarn: "#ff3b30"
    readonly property color cCold: "#a0ccf5"
    readonly property color cQuiet: "#8a929c"
    readonly property color cDim: "#6b7480"
    readonly property color cNoData: "#4a525c"
    readonly property color cTrack: "#1d252e"
    readonly property color cText: "#c9d1da"
    readonly property int mFast: 120
    readonly property int mBase: 200
    readonly property int mSlow: 280
    readonly property int mSmooth: 240
    readonly property int mSlide: 56

    // ===== Helpers =====
    function clamp01(v) { return v<0?0:v>1?1:v }
    // 48213 -> "48,213"; negative values take the U+2212 minus, as the design does.
    function fmtInt(n) {
        var s=String(Math.abs(Math.round(n))), o=""
        while(s.length>3) {
            o=","+s.slice(-3)+o
            s=s.slice(0, -3)
        }
        return (n<0?"−":"")+s+o
    }
    function signed(n, plus) { return n>0?(plus?"+":"")+n:n<0?"−"+(-n):"0" }
    function pad2(n) { return n<10?"0"+n:String(n) }
    // Design polar angles: 0 degrees = 12 o'clock, clockwise.
    function polX(cx, r, a) { return cx+r*Math.sin(a*Math.PI/180) }
    function polY(cy, r, a) { return cy-r*Math.cos(a*Math.PI/180) }
    function alarm(i) {
        var v=alarms[i]
        return typeof v==="number"?v:0
    }
    function tempOk(c) { return typeof c==="number" && c!==-1 && c!==0xFF && c!==0xFE && c!==0xFC }
    function tText(c) { return tempOk(c)?String(Math.round(tempC?c:c*1.8+32)):"--" }
    // Temperature table (design TEMP, round 33): cold, warm, and hot in degrees C; the scale ends lo and hi in degrees F.
    readonly property var tTable: ({ trans: [40, 111, 121, 100, 280], coolant: [60, 108, 113, 100, 260],
                                     oil: [70, 126, 136, 100, 300], cht: [60, 121, 132, 100, 300] })
    function tFrac(k, c) {
        var t=tTable[k]
        return t?clamp01((c*1.8+32-t[3])/(t[4]-t[3])):0
    }
    function tState(k, c) {
        var t=tTable[k]
        if(!t || !tempOk(c))
            return "nodata"
        return c<t[0]?"cold":c>=t[2]?"hot":c>=t[1]?"warm":"normal"
    }
    function tColor(st) { return st==="hot"?cWarn:st==="warm"?cCaution:st==="cold"?cCold:cQuiet }
    function econText(v) {
        switch(g.consumptionUnit) {
        case 0: return v.toFixed(1)
        case 1: return v>0?(100/v).toFixed(1):"--"
        default: return v>0?(235.2156/v).toFixed(1):"--"
        }
    }
    function railAt(pts, f) {
        var n=pts.length, k=f*n-0.5, i=Math.max(0, Math.min(n-2, Math.floor(k))), u=k-i, a=pts[i], b=pts[i+1]
        return [a[0]+(b[0]-a[0])*u, a[1]+(b[1]-a[1])*u, a[2]+(b[2]-a[2])*u, a[3]+(b[3]-a[3])*u]
    }

