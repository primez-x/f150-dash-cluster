            readonly property real max: mLayoutId.railMax
            readonly property real v: Math.min(max, mLayoutId.speedU)
            readonly property real vs: Math.min(max, mLayoutId.speedShown)
            readonly property real step: mLayoutId.metric?10:5
            function at(val, r) {
                var p=mLayoutId.railAt(mLayoutId.railEdge, Math.min(1, Math.max(0, val/max)))
                return [p[0]+p[2]*r, p[1]+p[3]*r, p[2], p[3]]
            }
            function svg(r) {
                var o=[]
                for(var i=0; i<=40; i++) {
                    var q=at(max*i/40, r)
                    o.push(q[0].toFixed(1)+" "+q[1].toFixed(1))
                }
                return "M"+o.join(" L")
            }
            readonly property string band: svg(70)
            readonly property var x0: at(0, 70)
            readonly property var head: at(vs, 70)
            width: 1920
            height: 932
            Shape {
                width: 1920
                height: 932
                ShapePath {
                    strokeColor: mLayoutId.cTrack
                    strokeWidth: 8
                    fillColor: "transparent"
                    capStyle: ShapePath.RoundCap
                    PathSvg { path: rail.band }
                }
            }
            // Fill: the full bar outline (8 px, round start) clipped at the head; the accent runs from 0.25 at zero to 1
            // at the head. Only the clip width, the gradient end, and the head dot follow the speed.
            readonly property string outline: {
                var a=[], b=[], i, q
                for(i=0; i<=40; i++) {
                    q=at(max*i/40, 74)
                    a.push(q[0].toFixed(1)+" "+q[1].toFixed(1))
                    q=at(max*(40-i)/40, 66)
                    b.push(q[0].toFixed(1)+" "+q[1].toFixed(1))
                }
                return "M"+a.join(" L")+" L"+b.join(" L")+" A4 4 0 0 1 "+a[0]+" Z"
            }
            Item {
                x: rail.x0[0]-4
                width: Math.max(0, rail.head[0]-rail.x0[0])+4
                height: 932
                clip: true
                visible: rail.vs>0.5
                Shape {
                    x: -parent.x
                    width: 1920
                    height: 932
                    ShapePath {
                        strokeColor: "transparent"
                        strokeWidth: -1
                        fillGradient: LinearGradient {
                            x1: rail.x0[0]; y1: 0; x2: Math.max(rail.x0[0]+1, rail.head[0]); y2: 0
                            GradientStop { position: 0; color: Qt.rgba(90/255, 209/255, 192/255, 0.25) }
                            GradientStop { position: 1; color: mLayoutId.cAcc }
                        }
                        PathSvg { path: rail.outline }
                    }
                }
            }
            Rectangle {
                visible: rail.vs>0.5
                x: rail.head[0]-4
                y: rail.head[1]-4
                width: 8
                height: 8
                radius: 4
                color: mLayoutId.cAcc
