                visible: mLayoutId.locker
                width: 14+22+6+lockLabel.width+14
                height: 34.4
                radius: 17.2
                color: mLayoutId.cCaution
                Loader {
                    property string sym: "padlock"
                    property color tint: "#05070a"
                    x: 14
                    y: 6.2
                    width: 22
                    height: 22
                    sourceComponent: mSymComp
                }
                Text {
                    id: lockLabel
                    x: 42
                    height: 34.4
                    verticalAlignment: Text.AlignVCenter
                    text: "R"
                    color: "#05070a"
                    font.family: mLayoutId.fBmw
                    font.pixelSize: 22
                    font.weight: Font.DemiBold
                }
            }
        }
    }

    // ===== View: alert banner =====
    // Banner (round 4 alert4, round 41 motion): top center under the compass, caution amber or warn red; a warn pulses
    // once. In within --m-fast from 12 px above; out over --m-base. Adapter text wraps on words to two lines.
    Item {
        id: alertBox
        objectName: "alert"
        readonly property var a: mLayoutId.alertShown
        readonly property bool warn: a[0]==="warn"
        readonly property color col: warn?mLayoutId.cWarn:mLayoutId.cCaution
        readonly property bool hasIcon: a[1]!==""
        readonly property bool hasSub: a[3]!==""
        readonly property real iconW: hasIcon?56:0
        x: 960-width/2
        y: 92
        width: 2+28+iconW+alertTitle.width+(hasSub?22+alertSub.width:0)+28+2
        height: Math.max(64, alertTitle.height+20)
        visible: false
        opacity: 0
        Rectangle {
            id: alertPulse
            property real spread: 0
            x: -spread
            y: -spread
            width: parent.width+2*spread
            height: parent.height+2*spread
            radius: 18+spread
            color: "transparent"
            border.color: mLayoutId.cWarn
            border.width: 3
            opacity: 0
        }
        Rectangle {
            anchors.fill: parent
            anchors.margins: -10
            radius: 28
            color: Qt.rgba(alertBox.col.r, alertBox.col.g, alertBox.col.b, 0.06)
        }
        Rectangle {
            anchors.fill: parent
            radius: 18
            color: Qt.rgba(alertBox.col.r, alertBox.col.g, alertBox.col.b, alertBox.warn?0.12:0.1)
            border.color: alertBox.col
            border.width: 2
        }
        Loader {
            property string sym: alertBox.a[1].indexOf("alarm:")===0?"":alertBox.a[1]
            property color tint: alertBox.col
            property bool flip: alertBox.a[4]===true
            visible: alertBox.hasIcon && sym!==""
            x: 30
            y: (alertBox.height-40)/2
            width: 40
            height: 40
            sourceComponent: mSymComp
        }
        Image {
            visible: alertBox.a[1].indexOf("alarm:")===0
            x: 30
            y: (alertBox.height-40)/2
            width: 40
            height: 40
            fillMode: Image.PreserveAspectFit
            source: visible?mLayoutId.g.mRccPrefix+"images/alarm/"+alertBox.a[1].slice(6)+".png":""
        }
        Text {
            id: alertTitle
            x: 30+alertBox.iconW
            y: (alertBox.height-height)/2
            width: Math.min(implicitWidth, 678-alertBox.iconW)
            verticalAlignment: Text.AlignVCenter
            wrapMode: Text.WordWrap
            maximumLineCount: 2
            elide: Text.ElideRight
            text: alertBox.a[2]
            color: alertBox.col
            font.family: mLayoutId.fBmw
            font.pixelSize: alertBox.hasIcon?30:26
            font.weight: Font.DemiBold
        }
        Text {
            id: alertSub
            visible: alertBox.hasSub
            x: alertTitle.x+alertTitle.width+22
            anchors.baseline: alertTitle.lineCount>1?undefined:alertTitle.baseline
            y: alertTitle.lineCount>1?(alertBox.height-height)/2:0
            height: 26.4
            verticalAlignment: Text.AlignVCenter
            text: alertBox.a[3]
            color: mLayoutId.cText
            font.family: mLayoutId.fBmw
            font.pixelSize: 22
        }
        transform: Translate { id: alertShift; y: 0 }
    }
    ParallelAnimation {
        id: mAlertInId
        PropertyAction { target: alertBox; property: "visible"; value: true }
        NumberAnimation { target: alertBox; property: "opacity"; from: 0; to: 1; duration: mFast; easing.type: Easing.OutCubic }
        NumberAnimation { target: alertShift; property: "y"; from: -12; to: 0; duration: mFast; easing.type: Easing.OutCubic }
    }
    SequentialAnimation {
        id: mAlertOutId
        ParallelAnimation {
            NumberAnimation { target: alertBox; property: "opacity"; to: 0; duration: mBase; easing.type: Easing.InCubic }
            NumberAnimation { target: alertShift; property: "y"; to: -8; duration: mBase; easing.type: Easing.InCubic }
        }
        PropertyAction { target: alertBox; property: "visible"; value: false }
    }
    // Warn pulse (round 4): one ring that grows 28 px and fades over 1.4 s.
    ParallelAnimation {
        id: mPulseId
        NumberAnimation { target: alertPulse; property: "spread"; from: 0; to: 28; duration: 1400; easing.type: Easing.OutCubic }
        NumberAnimation { target: alertPulse; property: "opacity"; from: 0.7; to: 0; duration: 1400; easing.type: Easing.OutCubic }
    }

    // ===== View: turn edges and bezel =====
    // Turn edges (round 4): bound to turnLeftLight and turnRightLight, which follow the truck flasher (compiled
    // TurnLightIndicator); a fast fade softens each change.
    Repeater {
        model: 2
        Item {
            objectName: index?"turn.r":"turn.l"
            readonly property bool on: index?mLayoutId.g.turnRightLight!==0:mLayoutId.g.turnLeftLight!==0
            x: index?1770:0
            width: 150
            height: 932
            opacity: on?1:0
            Behavior on opacity { NumberAnimation { duration: mLayoutId.mFast } }
            Shape {
                width: 150
                height: 932
                transform: Scale { origin.x: 0; origin.y: 466; yScale: 577.84/150 }
                ShapePath {
                    strokeColor: "transparent"
                    strokeWidth: -1
                    fillGradient: RadialGradient {
                        centerX: index?150:0; centerY: 466; centerRadius: 150; focalX: index?150:0; focalY: 466
                        GradientStop { position: 0; color: Qt.rgba(46/255, 224/255, 110/255, 0.5) }
                        GradientStop { position: 0.55; color: Qt.rgba(46/255, 224/255, 110/255, 0.1) }
                        GradientStop { position: 1; color: Qt.rgba(46/255, 224/255, 110/255, 0) }
                    }
                    startX: 0; startY: 466-466*150/577.84
                    PathLine { x: 150; y: 466-466*150/577.84 }
                    PathLine { x: 150; y: 466+466*150/577.84 }
                    PathLine { x: 0; y: 466+466*150/577.84 }
                    PathLine { x: 0; y: 466-466*150/577.84 }
                }
            }
            Rectangle {
                x: index?145:0
                y: 74.56
                width: 5
                height: 782.88
                radius: 3
                gradient: Gradient {
                    GradientStop { position: 0; color: "#2ee06e" }
                    GradientStop { position: 0.5; color: "#b9ffd2" }
                    GradientStop { position: 1; color: "#2ee06e" }
                }
            }
        }
    }
    // Bezel arch and steering column shroud (design mask): the hidden areas in the canvas colour.
    Shape {
        width: 1920
        height: 932
        ShapePath {
            strokeColor: Qt.rgba(1, 1, 1, 0.07)
            strokeWidth: 2
            fillColor: "#060708"
            PathSvg { path: "M0,0 L1920,0 L1920,106 L1880,98 L1840,90 L1800,82 L1760,75 L1720,68 L1680,61 L1640,55 L1600,49 L1560,43 L1520,38 L1480,34 L1440,29 L1400,25 L1360,21 L1320,18 L1280,15 L1240,12 L1200,10 L1160,8 L1120,6 L1080,5 L1040,4 L1000,4 L960,3 L920,4 L880,4 L840,5 L800,6 L760,8 L720,10 L680,12 L640,15 L600,18 L560,21 L520,25 L480,29 L440,34 L400,38 L360,43 L320,49 L280,55 L240,61 L200,68 L160,75 L120,82 L80,90 L40,98 L0,106 Z" }
        }
        ShapePath {
            strokeColor: Qt.rgba(1, 1, 1, 0.07)
            strokeWidth: 2
            fillColor: "#060708"
            PathSvg { path: "M180,932 L272,862 L300,845 L380,815 L480,792 L572,776 L1348,776 L1460,797 L1620,854 L1710,932 Z" }
        }
    }
}
