    // ===== View: card =====
    readonly property var cardBox: tow?[1390, 262, 530, 310]:[640, 536, 640, 176]
    readonly property var bodyBox: tow?[1430.8, 286.8, 449.2, 240.4]:[674.8, 548, 570.4, 130]
    property string cardShown: ""
    property int cardCur: 0
    onShownPageChanged: cardGo(shownPage)
    onTowChanged: {
        mSlideId.stop()
        cardA.page=shownPage
        cardB.page=""
        cardA.x=0
        cardA.opacity=1
        cardB.opacity=0
        cardCur=0
        cardShown=shownPage
    }
    function cardGo(p) {
        if(p===cardShown)
            return
        var from=pages.indexOf(cardShown), to=pages.indexOf(p)
        var dir=from<0 || to<0 || to===from?1:to>from?1:-1
        mSlideId.complete()
        var outL=cardCur===0?cardA:cardB, inL=cardCur===0?cardB:cardA
        inL.page=p
        mSlideOutId.target=outL
        mSlideOutFadeId.target=outL
        mSlideInId.target=inL
        mSlideInFadeId.target=inL
        mSlideOutId.to=-mSlide*dir
        mSlideInId.from=mSlide*dir
        cardCur=1-cardCur
        cardShown=p
        mSlideId.restart()
    }
    ParallelAnimation {
        id: mSlideId
        NumberAnimation { id: mSlideOutId; property: "x"; from: 0; duration: mFast; easing.type: Easing.InCubic }
        NumberAnimation { id: mSlideOutFadeId; property: "opacity"; to: 0; duration: mFast; easing.type: Easing.InCubic }
        SequentialAnimation {
            PropertyAction { target: mSlideInFadeId.target; property: "opacity"; value: 0 }
            PauseAnimation { duration: 40 }
            ParallelAnimation {
                NumberAnimation { id: mSlideInId; property: "x"; to: 0; duration: mSlow; easing.type: Easing.OutCubic }
                NumberAnimation { id: mSlideInFadeId; property: "opacity"; from: 0; to: 1; duration: mSlow; easing.type: Easing.OutCubic }
            }
        }
    }
